//@version=5
indicator("مركاز كاونت — تاسي 30 دقيقة v2.0 (2026-10-20)", overlay=true, max_labels_count=500)

// Hand count of TASI, taken from the reference chart of 2026-10-20.
//
// Every number is pinned to an exact (bar time + price) pair, exactly like the
// OpenStock manual overlay, so the count keeps its shape on any timeframe and
// on any device: nothing drifts with the price scale.
//
//   3  4  5  x  iii   -> red badge with a pointer (box under/over the swing)
//   a  b  c  iv  1  2  3 -> plain red number next to the swing
//   4 ?  v ?             -> wave-4 bounce and the final wave-5 low (projections)
//
// TASI only: on any other symbol the script draws nothing.

show = syminfo.ticker == "TASI" or syminfo.tickerid == "TADAWUL:TASI"

// ── helpers ────────────────────────────────────────────────────────────────
mkT(_y, _mo, _d, _h, _mi) => timestamp("Asia/Riyadh", _y, _mo, _d, _h, _mi)

badgeCol = color.rgb(179, 58, 52)
plainCol = color.rgb(232, 83, 79)
txtWhite = color.white
noFill = color.new(color.white, 100)
sz = size.normal

if show and barstate.islast
    // ── wave badges ───────────────────────────────────────────────────────
    label.new(mkT(2026, 10, 14, 10, 30), 10198.66, "3", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_up, color = badgeCol, textcolor = txtWhite, size = sz)
    label.new(mkT(2026, 10, 14, 11, 0), 10246.91, "4", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_down, color = badgeCol, textcolor = txtWhite, size = sz)
    label.new(mkT(2026, 10, 15, 11, 0), 10054.84, "5", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_up, color = badgeCol, textcolor = txtWhite, size = sz)
    label.new(mkT(2026, 10, 15, 11, 30), 10098.17, "x", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_down, color = badgeCol, textcolor = txtWhite, size = sz)
    label.new(mkT(2026, 10, 15, 14, 0), 10034.79, "iii", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_up, color = badgeCol, textcolor = txtWhite, size = sz)

    // ── plain wave numbers ────────────────────────────────────────────────
    label.new(mkT(2026, 10, 18, 12, 0), 10225.68, "a", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_none, color = noFill, textcolor = plainCol, size = sz)
    label.new(mkT(2026, 10, 18, 13, 0), 10168.28, "b", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_none, color = noFill, textcolor = plainCol, size = sz)
    label.new(mkT(2026, 10, 18, 14, 0), 10228.90, "c", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_none, color = noFill, textcolor = plainCol, size = sz)
    label.new(mkT(2026, 10, 18, 14, 0), 10258.45, "iv", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_none, color = noFill, textcolor = plainCol, size = sz)
    label.new(mkT(2026, 10, 19, 14, 0), 10074.34, "1", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_none, color = noFill, textcolor = plainCol, size = sz)
    label.new(mkT(2026, 10, 20, 10, 0), 10191.98, "2", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_none, color = noFill, textcolor = plainCol, size = sz)
    label.new(mkT(2026, 10, 20, 12, 0), 9943.33, "3", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_none, color = noFill, textcolor = plainCol, size = sz)

    // ── projections on the live edge ──────────────────────────────────────
    label.new(mkT(2026, 10, 20, 12, 30), 10041.2, "4 ?", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_none, color = noFill, textcolor = plainCol, size = sz)
    label.new(mkT(2026, 10, 20, 13, 0), 9928.7, "v ?", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_none, color = noFill, textcolor = plainCol, size = sz)
